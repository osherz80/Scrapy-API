# Placeholders only. The process does not load this file.
# Supply the same names in the host environment. Do not commit real values.

DATABASE_URL=postgresql://app_user:password@host:5432/postgres?sslmode=require
# Required together only when refresh dispatch is enabled. Leave all four unset otherwise.
GITHUB_REPOSITORY=osherz80/Scrapy-API
GITHUB_WORKFLOW_ID=refresh.yml
GITHUB_REF=refs/heads/main
GITHUB_TOKEN=replace-with-dispatch-token
PORT=3000
LOG_LEVEL=debug
LOG_ENV=development
APP_VERSION=dev
STALE_AFTER_HOURS=48
DB_QUERY_TIMEOUT_MS=15000
REQUEST_TIMEOUT_MS=30000
SEARCH_RATE_LIMIT_PER_MINUTE=60
REFRESH_RATE_LIMIT_PER_MINUTE=5
DB_CONCURRENCY=2
